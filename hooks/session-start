#!/usr/bin/env bash
# SessionStart hook for tw plugin (unified)

set -euo pipefail

session_context="You have the tw plugin installed.\n\nAvailable slash commands:\n- /all — Fullstack DDD workflow: orchestrates backend and frontend in sequence\n- /backend — Backend DDD end-to-end workflow\n- /frontend — Frontend end-to-end workflow consuming DDD API contracts\n- /easy — Lightweight development: clarify requirements then hand off to Claude Code native plan & code\n- /clarify — Requirements clarification (backend or frontend scenario)\n- /backend-thought — Backend DDD design phase\n- /backend-works — Backend DDD coding phase\n- /frontend-thought — Frontend design phase\n- /frontend-works — Frontend coding phase\n- /branch — Git feature branch management\n- /merge — Squash merge feature branch back to main/master\n\nThese skills are ONLY activated when the user explicitly invokes them via slash command.\nDo NOT auto-invoke these skills based on user intent or keywords. Only use them when the user types the slash command."

# Output context injection as JSON.
cat <<EOF
{
  "additional_context": "${session_context}",
  "hookSpecificOutput": {
    "hookEventName": "SessionStart",
    "additionalContext": "${session_context}"
  }
}
EOF

exit 0
